# Required for a deployed authenticated workspace
DATABASE_URL=
# Production enables certificate-verified TLS automatically. Set these only
# when a hosted MySQL/TiDB database must use TLS outside production.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
AUTH_SESSION_SECRET=
# JWT_SECRET is retained only if a managed OAuth adapter is enabled.
# JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Required for live Planner/Critic/chat AI responses
GROQ_API_KEY=
# Optional server-side model override; default supports strict JSON Schema outputs
GROQ_MODEL=openai/gpt-oss-20b

# Optional frontend platform integration
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Google OAuth (server-side only; callback must exactly match Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-production-domain.example/api/oauth/callback

# Optional future integrations; keep unset until implemented
# WEB_SEARCH_PROVIDER=
# WEB_SEARCH_API_KEY=
# EMBEDDINGS_PROVIDER=
# EMBEDDINGS_API_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
